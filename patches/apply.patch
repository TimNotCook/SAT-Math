diff --git a/app.css b/app.css
index 629518e..0e5c809 100644
--- a/app.css
+++ b/app.css
@@ -900,6 +900,13 @@ body.shell-drill .site-rail,body.shell-history .site-rail,body.jy-page .site-rai
 /* 讲义四个板块排成四等分，别落一个孤儿卡；模考记录空态也换成白卡 */
 body.jy-page #jyBoardCards{grid-template-columns:repeat(4,minmax(0,1fr))}
 body.jy-page #jyBoardCards .entry-tile b{font-size:14.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+/* 1440 的第四列只有 234px：8 个字的「问题解决与数据分析」被切成「问题解决与数…」。
+   四列时收紧内边距、图标和字距，把 17px 的缺口补回来；1000 以下已切两列。 */
+@media(min-width:1000px){
+  body.jy-page #jyBoardCards .entry-tile{padding:0 14px;gap:8px}
+  body.jy-page #jyBoardCards .entry-tile b{font-size:14px}
+  body.jy-page #jyBoardCards .entry-tile .entry-arrow{width:16px;height:16px}
+}
 @media(max-width:900px){body.jy-page #jyBoardCards{grid-template-columns:repeat(2,minmax(0,1fr))}}
 body.shell-history .hist-empty{padding:44px 24px;border:1px solid #e6ebf3;border-radius:14px;
   background:#fff;box-shadow:0 1px 2px rgba(15,23,42,.04);color:#7b8798}
@@ -1451,6 +1458,15 @@ html body.exam-page:not(.is-mock) #introStartCard#introStartCard .exam-special-p
 html body.exam-page .quiz-card-facts{gap:0!important;display:flex!important;align-items:flex-start!important}
 html body.exam-page .quiz-card-facts .quiz-fact{flex:0 0 104px!important;width:104px!important;margin:0!important;
   padding:0!important;min-width:0!important;border:0!important}
+/* 390/320 的模考卡只有 284/214px 宽，三个 104px 的定宽块排不下：
+   22、35 在上一行，「1」孤零零掉到第二行。手机档改成三格等分，一行放完。 */
+@media(max-width:520px){
+  html body.exam-page.is-mock .quiz-card-facts .quiz-fact{flex:1 1 0!important;width:auto!important;white-space:nowrap!important;
+    font-size:10.5px!important;letter-spacing:0!important}
+}
+@media(max-width:360px){
+  html body.exam-page.is-mock .quiz-card-facts .quiz-fact{font-size:10px!important}
+}
 
 /* 抽查开场左栏右侧那块空白：放一张本单元的浅色线稿，不做标签也不写字 */
 html body.exam-page:not(.is-mock) .mock-card-copy{position:relative!important}
