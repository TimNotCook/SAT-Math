+     笔画边界重新有"斜坡"，再用中心 5 的 3×3 卷积把斜坡掰回台阶，Tesseract 才切得开。
+     保留彩色、不做直方图拉伸——实测灰阶+拉伸反而把细笔画的弱边缘抹掉。 */
+  function deblurImage(dataUrl, targetW) {
+    return new Promise(function (res) {
+      var img = new Image();
