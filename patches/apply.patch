+                for (var c = 0; c < 3; c++) {
+                  var v = 5 * src[i4 + c] - src[i4 - 4 + c] - src[i4 + 4 + c] - src[i4 - W * 4 + c] - src[i4 + W * 4 + c];
+                  px[i4 + c] = v < 0 ? 0 : (v > 255 ? 255 : v);
+                }
+              }
+            }
+            cx.putImageData(d, 0, 0);
+          }
+          res(cv.toDataURL('image/jpeg', 0.92));
+        } catch (e) { res(null); }
+      };
+      img.onerror = function () { res(null); };
+      img.src = dataUrl;
+    });
+  }
