+  /* 进错题页就悄悄把 6.8MB 引擎拉下来（不点开面板也一样）。
+     理由：冷启动那 15–30 秒的等待本来就发生在"人还在看页面"的空档里，
+     等贴完图才开始下，就是纯等人。省流量模式（saveData）下不动。 */
+  (function autoPrewarmOnLoad() {
+    try {
+      var conn = navigator.connection || {};
+      if (conn.saveData) return;
+      var go = function () { try { prewarm(); } catch (e) {} };
+      if (window.requestIdleCallback) window.requestIdleCallback(go, { timeout: 1200 });
+      else setTimeout(go, 600);
+    } catch (e) {}
+  })();
