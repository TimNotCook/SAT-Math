diff --git a/test/i18n-filltopics.test.js b/test/i18n-filltopics.test.js
new file mode 100644
index 0000000..a596237
--- /dev/null
+++ b/test/i18n-filltopics.test.js
@@ -0,0 +1,24 @@
+'use strict';
+/* 抽查起始页「涵盖考点」会把 topic 里的「（填空）」剥掉再显示；剥掉后的名字
+   若没有英文词条，英文界面就会漏出中文（线上 320 实测到「表格求百分比」）。 */
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const i18n = fs.readFileSync(path.join(__dirname, '..', 'i18n.js'), 'utf8');
+
+const pairs = [
+  ['三角形内角与图形求角', 'Triangle angles'],
+  ['平行线被截线所截求角', 'Angles from parallel lines'],
+  ['直线方程与夹角参数', 'Line equation and angle parameters'],
+  ['表格求百分比', 'Percent from a table'],
+  ['频数表求中位数', 'Median from a frequency table'],
+];
+for (const [zh, en] of pairs) {
+  test(`剥掉（填空）后仍有英文：${zh}`, () => {
+    const re = new RegExp("'" + zh + "': '([^']*)'");
+    const m = i18n.match(re);
+    assert.ok(m, `缺少「${zh}」词条`);
+    assert.match(m[1], new RegExp(en), '英文词条内容不对');
+  });
+}
diff --git a/test/settings-tabs-wrap.test.js b/test/settings-tabs-wrap.test.js
new file mode 100644
index 0000000..3d5d1e9
--- /dev/null
+++ b/test/settings-tabs-wrap.test.js
@@ -0,0 +1,16 @@
+'use strict';
+/* 320 宽设置弹层五个 tab 等分 234px（每个约 47px），「Appearance」「Language」
+   会互相压字。窄屏必须允许换行、按内容取宽。 */
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const src = fs.readFileSync(path.join(__dirname, '..', 'cloud-account.js'), 'utf8');
+
+test('设置弹层窄屏 tab 允许换行且不强行等分', () => {
+  const m = src.match(/@media\(max-width:400px\)\{\.td-set-tabs\{([^}]*)\}/);
+  assert.ok(m, '缺少 ≤400px 的 tab 规则');
+  assert.match(m[1], /flex-wrap:wrap/, 'tab 仍会挤在一行互相压字');
+  const t = src.match(/@media\(max-width:400px\)\{[^\n]*\.td-set-tab\{([^}]*)\}/);
+  assert.ok(t && /flex:0 1 auto/.test(t[1]), 'tab 仍被 flex:1 等分到装不下文字');
+});
